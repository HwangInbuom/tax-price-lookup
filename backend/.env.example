# 카카오 디벨로퍼스 -> 내 애플리케이션 -> REST API 키
KAKAO_REST_API_KEY=

# 브이월드(V-World, api.vworld.kr) -> 마이포털 -> 나의 오픈API -> 인증키관리
# 공동주택가격(공시가격) 조회는 공공데이터포털이 아니라 브이월드 API로 호출된다.
VWORLD_API_KEY=

# 브이월드 인증키 발급 신청 시 등록한 도메인 (테스트 단계면 localhost로 등록)
VWORLD_DOMAIN=localhost

# 공시가격 기준연도 ("올해". 계산기가 상승률을 계산하는 기준점과 맞춰야 함)
PRICE_API_YEAR=2026

# (선택) 작년 공시가격 조회에 쓸 연도. 비워두면 PRICE_API_YEAR-1이 자동으로 쓰인다.
# 종부세 계산기의 "작년 공시가격" 칸을 자동으로 채우는 데 쓰인다.
PRICE_API_PREV_YEAR=

# data.go.kr -> "아파트매매 실거래가 상세 자료" 상세페이지 -> 마이페이지 > 데이터활용 >
# Open API > 활용신청 현황 에서 확인한 일반 인증키(Decoding). 이 API는 data.go.kr가 직접
# 호스팅해서, 상세페이지에 들어가는 순간 "개발계정"이 자동 승인되어 있다 (별도 신청 불필요).
DATA_GO_KR_SERVICE_KEY=
